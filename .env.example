# Your real production domain, no trailing slash. REQUIRED for `npm run build`.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Search Console → Settings → Ownership verification → "HTML tag":
# paste only the content="..." value here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools / Yandex Webmaster verification values.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
