# Apache / cPanel hosting. Ignored by hosts that do not use Apache.
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Only the hashed files under /_next/static are safe to cache for a year (see the NEXT_STATIC rule below).
  # Photos, icons and social cards keep their file names, so they get a short lifetime.
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Enable only once https works for the whole domain (it is sticky in browsers):
  # Header always set Strict-Transport-Security "max-age=31536000"
  # Fingerprinted build files (flagged by the rewrite rule below) never change, so cache them for a year.
  Header set Cache-Control "public, max-age=31536000, immutable" env=NEXT_STATIC
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^_next/static/ - [E=NEXT_STATIC:1]
</IfModule>

# Send everyone to ONE version of the site (https, and either www or non-www).
# Uncomment and replace your-domain.com once the SSL certificate is active.
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://your-domain.com%{REQUEST_URI} [L,R=301]
